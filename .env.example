# Plantilla de entorno para Spring y el build de Vite. No contiene secretos reales.
# node scripts/preparar-config-m2.mjs crea .env y completa sólo las claves vacías.
# Completar DB_PASSWORD con la contraseña de la base elegida antes del arranque.
SPRING_PROFILES_ACTIVE=staging
PORT=3000
DB_URL=jdbc:postgresql://localhost:5432/fitzone
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=
FITZONE_OFFLINE_PRIVATE_KEY=
VITE_API_URL=/api/v1
