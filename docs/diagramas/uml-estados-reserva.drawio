        <mxCell id="item-60" value="Por defecto, devuelve 100 % si restan ≥ 2 h y 50 % si restan &lt; 2 h." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=17;fontColor=#405469;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="742" y="850" width="645" height="22" as="geometry" />
        </mxCell>
        <mxCell id="item-61" value="Sólo Gerencia puede elegir explícitamente el 50 % o el 100 %." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=17;fontColor=#405469;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="742" y="873" width="645" height="22" as="geometry" />
        </mxCell>
        <mxCell id="item-62" value="Con pago previo, la devolución debe quedar confirmada." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=17;fontColor=#405469;fontStyle=0;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="742" y="896" width="645" height="22" as="geometry" />
        </mxCell>
      </root>
