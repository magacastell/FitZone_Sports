        <mxCell id="e14" value="API backend — monolito modular&#10;[Container: Java 21 / Spring Boot 4.1.1]&#10;M1/M2 y pagos de membresía; M3 incorporado:&#10;agenda, reservas, espera y Observer (avisos por log).&#10;M3: asistencia/penalidades pendientes; M4 parcial.&#10;PasarelaPagoFake interna, sin REST." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dceefa;strokeColor=#16324f;strokeWidth=2;fontFamily=Arial;fontSize=19;fontColor=#16324f;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
